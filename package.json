{
  "name": "sedea-extension-template",
  "displayName": "Sedea Extension Template",
  "description": "Starter template for user bespoke Sedea VS Code extensions.",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0",
    "node": "24.18.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sedeaExtensionTemplate.hello",
        "title": "Sedea Extension Template: Hello"
      }
    ]
  },
  "dependencies": {
    "@execution-flows/flow-compose": "0.3.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src webview-src .storybook",
    "typecheck": "tsc -p ./ --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "verify": "npm run lint && npm run typecheck && npm run compile && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test": "8.6.14",
    "@types/node": "25.6.2",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@types/vscode": "1.104.0",
    "@vitejs/plugin-react": "4.4.1",
    "chromatic": "11.28.0",
    "eslint": "^9.28.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "8.6.14",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "6.3.5",
    "vitest": "3.0.5"
  }
}
